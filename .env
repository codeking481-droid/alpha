# Alpha Agency Environment Variables — FILL ALL, then wiring is automatic
# This file stays local (not pushed if you add to .gitignore). Backend uses .dev.vars for Wrangler.

# Supabase — https://supabase.com → New Project → Settings → API → Copy URL + anon key
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional service key for writes (if RLS enabled) — Settings → API → service_role
SUPABASE_SERVICE_KEY=

# Groq — https://console.groq.com/keys → Create API Key
GROQ_API_KEY=

# Cloudflare — dash.cloudflare.com → Account ID (right sidebar) + API Token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# D1 — after npx wrangler d1 create alphatekx-db, paste ID here
D1_DATABASE_ID=
R2_BUCKET_NAME=alphatekx-storage

ENV=production
VITE_API_URL=https://alphatekx-agency-backend.workers.dev
